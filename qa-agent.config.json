{
  "provider": "ollama",
  "ollama": {
    "url": "http://localhost:11434",
    "model": "llama3.1",
    "temperature": 0.3,
    "maxTokens": 4096
  },
  "anthropic": {
    "apiKey": "",
    "model": "claude-sonnet-4-5",
    "temperature": 0.2,
    "maxTokens": 8192
  },
  "execution": {
    "maxEndpoints": 5,
    "testTimeoutSeconds": 15,
    "selfHealingAttempts": 3,
    "assertionHealingAttempts": 2,
    "maxParallelGroups": 4,
    "maxParallelMethods": 5
  },
  "output": {
    "saveGeneratedTests": true,
    "historyDir": ".qa-history",
    "reportDir": "."
  },
  "auth": {
    "type": "none",
    "bearerToken": null,
    "apiKeyHeader": "X-API-Key",
    "apiKeyValue": null,
    "basicUsername": null,
    "basicPassword": null
  }
}